# ---------------------------------------------------------------------------
# MarSel Marketing sayti — muhit o'zgaruvchilari (NAMUNA)
# Haqiqiy qiymatlar: Vercel > Project > Settings > Environment Variables.
# Lokal ishga tushirish uchun shu faylni .env.local ga nusxalang.
# Bu faylga HECH QACHON haqiqiy token yozilmaydi.
# NEXT_PUBLIC_* o'zgaruvchilar build vaqtida kodga qo'shiladi — o'zgartirgach Redeploy qiling.
# ---------------------------------------------------------------------------

# Saytning asosiy domeni (canonical, hreflang, sitemap, OG, schema.org uchun). Oxirida "/" yo'q.
NEXT_PUBLIC_SITE_URL=https://marsel-agency.vercel.app

# --- Ariza formasi -> Telegram ----------------------------------------------
# @BotFather -> @MarSelMarketingBot -> API Token
TELEGRAM_BOT_TOKEN=
# Arizalar tushadigan chat/guruh ID (guruh bo'lsa "-100..." bilan boshlanadi)
TELEGRAM_CHAT_ID=

# --- Analitika (faqat cookie roziligidan keyin yuklanadi) -------------------
# Bo'sh qoldirilsa, o'sha skript umuman yuklanmaydi. Hammasi bo'sh bo'lsa, cookie banner ham chiqmaydi.
# GA4: Admin > Data streams > Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Meta Pixel: Events Manager > Data sources > Pixel ID (faqat raqamlar)
NEXT_PUBLIC_META_PIXEL_ID=
# Yandex Metrika: hisoblagich raqami (faqat raqamlar)
NEXT_PUBLIC_YM_ID=
