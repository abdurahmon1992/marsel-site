# ---------------------------------------------------------------------------
# Marsel-site — muhit o'zgaruvchilari (namuna)
# Haqiqiy qiymatlarni Vercel > Project > Settings > Environment Variables
# bo'limiga kiriting. Bu faylda HECH QACHON haqiqiy maxfiy kalit saqlanmaydi.
# ---------------------------------------------------------------------------

# Neon Postgres ulanishi (Vercel Neon integratsiyasi avtomatik qo'shadi)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Telegram bot tokeni — BotFather'dan olinadi (@BotFather -> /newbot yoki /token)
TELEGRAM_BOT_TOKEN=123456:AA...

# Bot username (@ belgisisiz), masalan: marsel_login_bot
TELEGRAM_BOT_USERNAME=your_bot_username

# Saytga kirishga ruxsat etilgan yagona Telegram foydalanuvchi ID si
ALLOWED_TELEGRAM_ID=5946966965

# Sessiya JWT imzosi uchun uzun tasodifiy satr (masalan: openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_long_random_string

# Telegram webhook'ni himoyalash uchun maxfiy header qiymati (tasodifiy satr)
TELEGRAM_WEBHOOK_SECRET=change_me_random

# /api/telegram/set-webhook endpointini himoyalovchi maxfiy kalit (tasodifiy satr)
SETUP_SECRET=change_me_random

# ---------------------------------------------------------------------------
# AI assistent boti (Sprint 2) — alohida Telegram bot + Gemini API
# ---------------------------------------------------------------------------

# AI assistent boti tokeni — BotFather'dan olingan ALOHIDA bot (login botidan boshqa)
ASSISTANT_BOT_TOKEN=123456:AA...

# AI assistent webhook'ini himoyalash uchun maxfiy header qiymati (tasodifiy satr)
ASSISTANT_WEBHOOK_SECRET=change_me_random

# LLM provayderi: 'gemini' (default) yoki 'claude'
LLM_PROVIDER=gemini

# --- Gemini (LLM_PROVIDER=gemini bo'lganda) ---
# Google Gemini API kaliti — https://aistudio.google.com/app/apikey dan olinadi
GEMINI_API_KEY=AIza...
# Gemini modeli (ixtiyoriy, default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# --- Claude / Anthropic (LLM_PROVIDER=claude bo'lganda) ---
# Anthropic API kaliti — https://console.anthropic.com dan olinadi
ANTHROPIC_API_KEY=sk-ant-...
# Claude modeli (ixtiyoriy, default: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Shaxsiy yordamchi: vazifalar va eslatmalar ---
# Eslatmalar ko'rsatiladigan vaqt zonasi (ixtiyoriy, default: Asia/Tashkent)
ASSISTANT_TZ=Asia/Tashkent
# Eslatma cron endpointini himoyalovchi kalit — ixtiyoriy, faqat Vercel Pro
# Cron ishlatilsa kerak. Tashqi cron (cron-job.org) SETUP_SECRET'dan foydalanadi:
#   https://<domen>/api/assistant/cron?secret=<SETUP_SECRET>
CRON_SECRET=change_me_random
